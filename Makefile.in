.POSIX:

EMACS = env EMACS_MODULE_RS_DEBUG=1 "@EMACS@"
EMACSFLAGS = @EMACSFLAGS@ -Q -batch -L . -L lisp -L @CARGO_OUTPUT_DIR@
CARGO = env RUSTFLAGS="@RUSTFLAGS@" @CARGO@
CARGOFLAGS = @CARGOFLAGS@

all:

check: lisp/test-module-tests.elc lisp/test-module-28-tests.elc
	${CARGO} test ${CARGOFLAGS}
	${EMACS} ${EMACSFLAGS} @CARGO_OUTPUT_DIR@ -l ert -l test-module-tests -f ert-run-tests-batch-and-exit
	${EMACS} ${EMACSFLAGS} @CARGO_OUTPUT_DIR@ -l ert -l test-module-28-tests -f ert-run-tests-batch-and-exit

lisp/test-module-tests.elc: @CARGO_OUTPUT_DIR@/test-module.@SO_SUFFIX@
lisp/test-module-28-tests.elc: @CARGO_OUTPUT_DIR@/test-module-28.@SO_SUFFIX@

@CARGO_OUTPUT_DIR@/test-module.@SO_SUFFIX@: @CARGO_OUTPUT_DIR@/@TEST_MODULE@
	cp $< $@
@CARGO_OUTPUT_DIR@/test-module-28.@SO_SUFFIX@: @CARGO_OUTPUT_DIR@/@TEST_MODULE_28@
	cp $< $@

# find test-module -name '*.rs' -o -name '*.toml' | sort | xargs echo
@CARGO_OUTPUT_DIR@/@TEST_MODULE@: test-module/Cargo.toml	\
	test-module/src/basics.rs test-module/src/call.rs		\
	test-module/src/eq.rs test-module/src/error.rs			\
	test-module/src/hash_map.rs test-module/src/lib.rs		\
	test-module/src/lifetime.rs test-module/src/macros.rs	\
	test-module/src/ref_cell.rs test-module/src/vector.rs	\
	test-module/src/vector_2d.rs

	${CARGO} build --manifest-path=$< ${CARGOFLAGS}

# find test-module-28 -name '*.rs' -o -name '*.toml' | sort | xargs echo
@CARGO_OUTPUT_DIR@/@TEST_MODULE_28@: test-module-28/Cargo.toml		\
	test-module-28/src/lib.rs test-module-28/src/test_channel.rs
	${CARGO} build --manifest-path=$< ${CARGOFLAGS}

.el.elc:
	${EMACS} ${EMACSFLAGS} -l bytecomp -f batch-byte-compile $<

.SUFFIXES: .el .elc

.PHONY: all check
